node_modules/
dist/
dist-site/
coverage/
*.tsbuildinfo
*.log

# ---- Imported game content -------------------------------------------------
#
# Nothing extracted from a licensed Descent or Mansions of Madness install is
# ours to redistribute. The import pipeline writes to
# ~/.cache/valkyrie-web-port/, outside the repository entirely; this is the
# backstop for an import pointed here by mistake.
#
# Safe to match by extension *here* in a way it is not at the repository root:
# none of these formats has any business under webapp/, and none is tracked.
# Textures. The importer writes .webp, but falls back to .png when the host
# cannot encode WebP (ffgImport.ts:429), so both have to be covered.
*.dds
*.pvr
*.ktx
*.astc
*.webp
*.png
*.jpg
*.jpeg
# Authored artwork gets one obvious home, exempt from the rule above. Anything
# imported has no business here, and anything here has to be put there on
# purpose.
!packages/app/icons/
!packages/app/icons/**
# Audio
*.fsb
*.bank
*.ogg
*.wav
*.mp3
# Unity containers
*.assets
*.assets.resS
*.resS
*.resource
*.bundle
*.unity3d
*.sharedAssets
# Game text assets, localisation dumps and content packs. The import cache
# holds 671 .txt and 105 .ini files pulled straight out of the install; none of
# those formats is tracked under webapp/, so ignoring them wholesale costs
# nothing and catches an import that lands here by mistake.
*.txt
*.ini
*.zip
Localization_*.txt
*.valkyrie
# Anywhere an import might land
ffg/
.cache/
**/imported/

# ---- Differential harness working files ------------------------------------
#
# Wildcards rather than a list per harness: the list had to be extended by hand
# every time a harness was added, and forgetting was silent.
tools/differential/.work/
tools/differential/*/.work/
tools/differential/*/bin/
tools/differential/*/obj/

# Every C# file under the harnesses is a copy of a Unity source unless it is
# one of ours, so they are ignored by default and the handful we wrote are
# named back in. This fails safe: a newly copied source needs no new rule, and
# forgetting one cannot quietly duplicate upstream's code into this tree.
tools/differential/**/*.cs
!tools/differential/**/*Shim.cs
!tools/differential/**/*Shims.cs
!tools/differential/**/Program.cs
!tools/differential/**/Probe.cs
!tools/differential/**/SetVersionProbe.cs

# ---- FFG import probe -------------------------------------------------------
tools/ffg/probe/bin/
tools/ffg/probe/obj/

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <AssemblyName>activationharness</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0414;CS0649;CS0168</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Extracted.cs" />
    <Compile Include="Symbols.cs" />
    <Compile Include="StringKey.cs" />
    <Compile Include="DictionaryI18n.cs" />
    <Compile Include="LocalizationRead.cs" />
    <Compile Include="Shims.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>

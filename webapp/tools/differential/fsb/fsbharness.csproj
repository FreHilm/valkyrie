<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <AssemblyName>fsbharness</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0414;CS0108;CS0162;CS0219;CS0169;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="oggencoder/**/*.cs" Exclude="oggencoder/Properties/AssemblyInfo.cs" />
    <Compile Include="FSBExport.cs" />
    <Compile Include="OggVorbisHeader.cs" />
    <Compile Include="EndianBinaryReader.cs" />
    <Compile Include="EndianType.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>

{
  "name": "valkyrie-web",
  "private": true,
  "version": "0.0.0",
  "description": "Web port of Valkyrie",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev --workspace @valkyrie/app",
    "build:site": "npm run build:site --workspace @valkyrie/app"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/rollup-darwin-arm64": "^4.63.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}

.DS_Store
[Dd]esktop.ini

/build/

# FFG imported content
/content/D2E/ffg
/content/MoM/ffg

# Auto generated files
/libraries/FFGAppImport/obj
/libraries/ValkyrieTools/obj
unity/Assets/StreamingAssets/crashlytics-build.properties
unity/Assets/StreamingAssets/crashlytics-build.properties.meta
.idea/
unity/Assets/Plugins/Editor/JetBrains/
unity/Assets/Plugins/Editor/JetBrains.meta
unity/Assets/TextMesh Pro/Examples & Extras/
unity/Assets/Plugins/Editor.meta
unity/Assets/TextMesh Pro/Examples & Extras.meta
/unity/Packages/packages-lock.json
/unity/ProjectSettings/PackageManagerSettings.asset
/unity/.vsconfig
/docs/superpowers/

# Unity build output and logs.
#
# The first three are tracked upstream and left alone — removing them is not
# this branch's business. These rules stop *new* ones being added: they are
# machine-local licensing and package chatter that changes on every run.
compile-check.log
compile-results.log
/unity/Logs/
*.log
!compile-check.log
!compile-results.log
/unity/Library/
/unity/Temp/
/unity/Obj/
/unity/Build/
/unity/Builds/
/unity/UserSettings/
/unity/MemoryCaptures/
/unity/Recordings/
# Unity regenerates these in /unity/. Scoped rather than global: the C#
# libraries under /libraries/ have real, tracked .csproj files, and so do the
# differential harnesses under /webapp/tools/.
/unity/*.csproj
/unity/*.unityproj
/unity/*.sln
/unity/*.suo
/unity/*.user
/unity/*.userprefs
/unity/*.pidb
/unity/*.booproj
/unity/sysinfo.txt

# ---- Imported game content -------------------------------------------------
#
# Assets extracted from a licensed Descent or Mansions of Madness install are
# not ours to redistribute. The import pipeline writes them to
# ~/.cache/valkyrie-web-port/, outside this repository by design; everything
# below is the backstop for an import accidentally pointed somewhere inside it.
#
# Deliberately NOT global by extension. Upstream legitimately tracks
# unity/Assets/Resources/*.dds, test.ogg, and 276 .png files across unity/,
# web/ and wiki/ — a blanket rule would fight real content. The formats are
# ignored under webapp/ instead, where none of them belong (see
# webapp/.gitignore), and only unmistakably-FFG artefacts are matched here.
/ffg-import/
/import/
**/.valkyrie-cache/
**/valkyrie-web-port/

# FFG's own localisation dumps, extracted from a licensed install. Underscore,
# not dot: upstream's own Localization.English.txt must stay tracked.
Localization_*.txt

# Community scenario packages, downloaded rather than authored here.
*.valkyrie
